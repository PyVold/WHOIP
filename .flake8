[flake8]
max-line-length = 127
max-complexity = 10
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    venv,
    env,
    ENV,
    .venv,
    migrations,
    logs,
    *.pyc,
    .DS_Store

# Ignore some common warnings
ignore =
    E203,  # whitespace before ':'
    E501,  # line too long (handled by max-line-length)
    W503,  # line break before binary operator
    E402,  # module level import not at top of file
    F401,  # imported but unused (in __init__ files)

per-file-ignores =
    __init__.py:F401
    tests/*:F401,E501

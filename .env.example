# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-generate-with-secrets-token-hex-32

# Database Configuration
DATABASE_URL=sqlite:///lite2.db
# For PostgreSQL: postgresql://username:password@localhost/dbname
# For MySQL: mysql://username:password@localhost/dbname

# Application Settings
MAX_APPS_PER_USER=3
DEFAULT_RATE_LIMIT=1000

# External API Configuration
RIPE_API_URL=https://stat.ripe.net/data/maxmind-geo-lite/data.json
RIPE_API_TIMEOUT=5

# Security Settings
SESSION_COOKIE_SECURE=False
MIN_PASSWORD_LENGTH=8
REQUIRE_PASSWORD_UPPERCASE=True
REQUIRE_PASSWORD_LOWERCASE=True
REQUIRE_PASSWORD_DIGIT=True
REQUIRE_PASSWORD_SPECIAL=False

# Cache Configuration
CACHE_TYPE=simple
REDIS_URL=redis://localhost:6379/0
CACHE_TIMEOUT=3600

# Rate Limiting
RATELIMIT_ENABLED=True

# Logging
LOG_LEVEL=INFO

# Email Configuration (for future password reset features)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@ipdevops.com

# Admin Users (comma-separated)
ADMIN_USERS=admin

# Flask-Admin
FLASK_ADMIN_SWATCH=cerulean
